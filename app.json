{
  "expo": {
    "name": "BTR Ticketing",
    "slug": "btr-ticketing-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1A2B5E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.btrworship.ticketing"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A2B5E"
      },
      "package": "com.btrworship.ticketing",
      "permissions": []
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "@react-native-async-storage/async-storage",
        {
          "exclude": []
        }
      ]
    ]
  }
}
